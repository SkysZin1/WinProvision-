<Window x:Class="WinProvision.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Ui001}" Icon="Assets/WinProvision.ico" Width="1220" Height="820" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="254"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#122E33" Padding="24,30">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <Image Source="Assets/Logo.png" Width="56" Height="56" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{DynamicResource Ui002}"/>
     <TextBlock Text="WinProvision" Foreground="White" FontSize="23" FontWeight="SemiBold" Margin="0,18,0,3"/>
     <TextBlock Text="{DynamicResource Ui003}" Foreground="#9DBEBB" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,38"/>
     <Button x:Name="MediaNav" Content="{DynamicResource Ui004}" Click="Media_Click" HorizontalContentAlignment="Left" Margin="0,0,0,10"/>
     <Button x:Name="OptionsNav" Content="{DynamicResource Ui005}" Click="Options_Click" Margin="0,0,0,10"/>
     <Button x:Name="ReviewNav" Content="{DynamicResource Ui006}" Click="Review_Click"/>
     <Button Content="{DynamicResource Ui007}" Click="Applications_Click" Margin="0,12,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
     <TextBlock Text="{DynamicResource Ui008}" Foreground="#A4C5BF" FontSize="12" FontWeight="SemiBold" LineHeight="19"/>
     <TextBlock Text="Idioma / Language" Foreground="#A4C5BF" FontSize="12" Margin="0,18,0,6"/>
     <ComboBox x:Name="InterfaceLanguageChoice" SelectionChanged="InterfaceLanguage_Changed" AutomationProperties.Name="Idioma / Language"><ComboBoxItem Content="Português (Brasil)" Tag="pt-BR"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox>
     <Separator Background="#345056" Margin="0,20,0,16"/>
     <TextBlock Text="{DynamicResource Ui009}" Foreground="#89ABA7" FontSize="11" LineHeight="19"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="34,26,34,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="PageEyebrow" Text="{DynamicResource Ui010}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="PageTitle" Text="{DynamicResource Ui011}" FontSize="29" FontWeight="SemiBold" Margin="0,6,0,6"/><TextBlock x:Name="PageSubtitle" Text="{DynamicResource Ui012}" Foreground="{StaticResource Muted}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0"><Button Content="{DynamicResource Ui013}" Click="Load_Click" Margin="0,0,8,0" Padding="12,8"/><Button Content="{DynamicResource Ui014}" Click="Save_Click" Padding="12,8"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="MediaPage" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <Border Background="#E2F0E9" CornerRadius="12" Padding="23" Margin="0,0,0,20"><StackPanel><TextBlock Text="{DynamicResource Ui015}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Ui016}" Foreground="#3E6258" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Background="White" BorderBrush="#DFE7E2" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,16"><StackPanel>
       <TextBlock Text="{DynamicResource Ui017}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Ui018}" Foreground="{StaticResource Muted}" Margin="0,5,0,14"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="IsoPath" IsReadOnly="True" Text="{DynamicResource Ui019}"/><Button Grid.Column="1" Content="{DynamicResource Ui020}" Click="Browse_Click" Margin="10,0,0,0"/></Grid>
       <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Ui021}" Margin="0,0,0,6"/><ComboBox x:Name="WindowsChoice" SelectionChanged="Windows_Changed"><ComboBoxItem Content="Windows 11" IsSelected="True"/><ComboBoxItem Content="Windows 10"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{DynamicResource Ui022}" Margin="0,0,0,6"/><ComboBox x:Name="EditionChoice"/></StackPanel>
       </Grid>
       <TextBlock Text="{DynamicResource Ui023}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
       <Button Content="{DynamicResource Ui024}" Click="Download_Click" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="0,3" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Accent}"/>
      </StackPanel></Border>
      <Border Background="White" BorderBrush="#DFE7E2" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,16"><StackPanel>
       <TextBlock Text="{DynamicResource Ui025}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Ui026}" Foreground="{StaticResource Muted}" Margin="0,5,0,14"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="DiskChoice" MinWidth="320"/><Button Grid.Column="1" x:Name="RefreshButton" Content="{DynamicResource Ui027}" Click="Refresh_Click" Margin="10,0,0,0"/></Grid>
       <TextBlock x:Name="DiskStatus" Text="{DynamicResource Ui028}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
      </StackPanel></Border>
      <TextBlock Text="{DynamicResource Ui029}" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="20" Margin="4,0,4,18"/>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="ProfilePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,0,8,0">
      <UniformGrid Columns="3" Margin="0,0,0,20">
       <Button x:Name="DefaultProfileButton" Click="DefaultProfile_Click" Padding="18" Margin="0,0,8,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <StackPanel><TextBlock x:Name="DefaultProfileState" Text="{DynamicResource Ui030}" FontSize="10" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="{DynamicResource Ui031}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="{DynamicResource Ui032}" FontSize="13" FontWeight="Normal"/><TextBlock Text="{DynamicResource Ui033}" Foreground="{StaticResource Muted}" FontWeight="Normal" FontSize="12" Margin="0,14,0,0"/></StackPanel>
       </Button>
       <Button x:Name="RecommendedProfileButton" Click="RecommendedProfile_Click" Padding="18" Margin="4,0,4,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <StackPanel><TextBlock x:Name="RecommendedProfileState" Text="{DynamicResource Ui034}" FontSize="10" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="{DynamicResource Ui035}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="{DynamicResource Ui036}" FontSize="13" FontWeight="Normal"/><TextBlock Text="{DynamicResource Ui037}" Foreground="{StaticResource Muted}" FontWeight="Normal" FontSize="12" Margin="0,14,0,0"/></StackPanel>
       </Button>
       <Button x:Name="CustomProfileButton" Click="CustomProfile_Click" Padding="18" Margin="8,0,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <StackPanel><TextBlock x:Name="CustomProfileState" Text="{DynamicResource Ui038}" FontSize="10" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock Text="{DynamicResource Ui039}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="{DynamicResource Ui040}" FontSize="13" FontWeight="Normal"/><TextBlock Text="{DynamicResource Ui041}" Foreground="{StaticResource Muted}" FontWeight="Normal" FontSize="12" Margin="0,14,0,0"/></StackPanel>
       </Button>
      </UniformGrid>
      <Border Background="White" BorderBrush="#DFE7E2" BorderThickness="1" CornerRadius="10" Padding="22">
       <StackPanel><TextBlock x:Name="PresetSummaryTitle" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="PresetSummaryIntro" Foreground="{StaticResource Muted}" Margin="0,8,0,14"/><StackPanel x:Name="PresetSummaryOptions"/><TextBlock x:Name="PresetSummaryNote" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/><Button x:Name="CustomizePresetButton" Content="{DynamicResource Ui042}" Click="CustomizePreset_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel>
      </Border>
      <TextBlock Text="{DynamicResource Ui043}" FontSize="12" Foreground="{StaticResource Muted}" Margin="4,16,4,12"/>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="OptionsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Button Content="{DynamicResource Ui044}" Click="BackToProfiles_Click" HorizontalAlignment="Left" Padding="0,5" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Accent}" Margin="0,0,0,12"/>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Ui045}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/><TextBox Grid.Row="1" x:Name="Search" ToolTip="{DynamicResource Ui046}" TextChanged="Search_Changed"/><Button Grid.Row="1" Grid.Column="1" Content="{DynamicResource Ui047}" Click="Reset_Click" Margin="12,0,0,0"/></Grid>
     <WrapPanel x:Name="Categories" Grid.Row="2" Margin="0,12,0,10"/>
     <ScrollViewer x:Name="OptionsScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="OptionCards"/></ScrollViewer>
    </Grid>
    <ScrollViewer x:Name="ReviewPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Background="White" CornerRadius="10" Padding="22" Margin="0,0,0,16"><StackPanel><TextBlock Text="{DynamicResource Ui048}" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="ReviewSummary" Margin="0,14,0,0" LineHeight="25"/><Button Content="{DynamicResource Ui049}" Click="Preview_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
     <Border Background="#FFF1D9" BorderBrush="#E6CB98" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="{DynamicResource Ui050}" FontSize="17" FontWeight="SemiBold" Foreground="#7C4C12"/><TextBlock Text="{DynamicResource Ui051}" Foreground="#795D35" Margin="0,8,0,14"/>
      <CheckBox x:Name="EraseConsent" Content="{DynamicResource Ui052}"/>
      <TextBlock x:Name="ConfirmLabel" Margin="0,16,0,6" Text="{DynamicResource Ui053}"/><TextBox x:Name="ConfirmText" MaxWidth="360" HorizontalAlignment="Left" MinWidth="280"/>
     </StackPanel></Border>
     <TextBlock Text="{DynamicResource Ui054}" Foreground="{StaticResource Muted}" FontSize="12" Margin="4,0,4,16"/>
     <Button x:Name="CreateButton" Content="{DynamicResource Ui055}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="Create_Click" Padding="22,14"/>
    </StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="2" BorderBrush="#DAE3DE" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="StatusText" Text="{DynamicResource Ui056}" Foreground="{StaticResource Muted}" FontSize="12"/><ProgressBar x:Name="Progress" Visibility="Collapsed" Height="4" Margin="0,10,20,0" Foreground="{StaticResource Accent}"/><Button x:Name="LogButton" Visibility="Collapsed" Content="{DynamicResource Ui057}" Click="Log_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,4"/></StackPanel>
    <Button x:Name="NextButton" Grid.Column="1" Content="{DynamicResource Ui058}" Style="{StaticResource Primary}" Click="Next_Click" Margin="16,0,0,0" VerticalAlignment="Top"/>
   </Grid></Border>
  </Grid>
 </Grid>
</Window>
